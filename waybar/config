{
    "layer": "top",
    "height": 40,
    "spacing": 4,
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/theme",
        "cpu",
        "temperature",
        "backlight",
        "pulseaudio",
        "battery",
        "tray",
        "custom/signal",
        "custom/whatsapp",
        "clock",
        "custom/power"
    ],
    "clock": {
        "format": "{:%d %b - %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
                    "mode"          : "month",
                    "mode-mon-col": 2,
                    "on-scroll"     : 1,
                    "format": {
                              "months":     "<b>{}</b>",
                              "days":       "{}",
                              "weekdays":   "<span color='#fe640b'><b>{}</b></span>",
                              "today":      "<span color='#8839ef'><b><u>{}</u></b></span>"
                              }
                    },
        "actions":  {
                    "on-click-right": "mode",
                    "on-scroll-up": "shift_up",
                    "on-scroll-down": "shift_down"
                    }
    },
    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": false,
        "on-click": "kitty --override background=#000000 htop"
    },
    "battery": {
		"on-click": "~/.local/bin/power-menu",
		"states": {
			 "warning": 25,
			 "critical": 10
		},
		"format": "{capacity}% {icon}",
		"format-charging": "{capacity}%  {icon}",
		"format-plugged": "{capacity}%  {icon}",
		"format-icons": ["", "", "", "", ""]
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["", "", ""],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 16
    },
    "custom/theme": {
        "format": "{}",
        "exec": "~/.local/bin/theme-status",
        "interval": 2,
        "on-click": "~/.local/bin/theme-toggle",
        "tooltip": false
    },
    "custom/signal": {
        "format": "",
        "return-type": "json",
        "exec": "~/.local/bin/app-toggle signal status",
        "interval": "once",
        "signal": 8,
        "tooltip": false,
        "on-click": "~/.local/bin/app-toggle signal",
        "on-click-middle": "~/.local/bin/app-toggle signal quit"
    },
    "custom/whatsapp": {
        "format": "",
        "return-type": "json",
        "exec": "~/.local/bin/app-toggle whatsapp status",
        "interval": "once",
        "signal": 8,
        "tooltip": false,
        "on-click": "~/.local/bin/app-toggle whatsapp",
        "on-click-middle": "~/.local/bin/app-toggle whatsapp quit"
    },
    "custom/power": {
        "format": "{}",
        "exec": "echo ",
        "interval": "once",
        "tooltip": false,
        "on-click": "~/.local/bin/power-actions"
    }
}
